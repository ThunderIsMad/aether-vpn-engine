##[group]Run set -euo pipefail
set -euo pipefail
want="$(awk -F'"' '/^[[:space:]]*channel[[:space:]]*=/{print $2; exit}' rust-toolchain.toml)"
if [ -z "$want" ]; then
  echo "::error::не прочитал channel из rust-toolchain.toml"
  exit 1
fi
case "$want" in
  *-windows-*|*-apple-*|*-linux-*|*-unknown-*)
    echo "::error::rust-toolchain.toml несёт host-триплет ($want): для rustup это non-host toolchain, авто-установка скачала бы компилятор чужой платформы. Пину положено нести только версию — host задаёт платформенный слой (scripts/local-env.sh на Windows, сам раннер в CI)."
    exit 1 ;;
esac
# Явная установка пина: авто-установка тулчейна из toolchain-файла объявлена rustup'ом
# устаревшей («auto-installation is deprecated for most `rustup` commands») — CI не
# должен на неё опираться (замечание из живого лога, run 35308984056).
rustup toolchain install "$want"
host="$(rustc -vV | sed -n 's/^host: //p')"
release="$(rustc -vV | sed -n 's/^release: //p')"
rustup show
echo "resolved toolchain: channel=$want host=$host release=$release"
case "$host" in
  *-windows-*|*-apple-*)
    echo "::error::активный toolchain собран не для этого раннера ($host)"
    exit 1 ;;
esac
if [[ "$want" == *.* ]] && [ "$release" != "$want" ]; then
  echo "::error::версия rustc ($release) не совпадает с пином ($want) — пин не применился"
  exit 1
fi
