##[group]Run # Actions запускает run-блоки как `bash -e`: свои падения собираем сами
# Actions запускает run-блоки как `bash -e`: свои падения собираем сами
set +e
set -uo pipefail
GH_TOKEN="***"
API="$GITHUB_API_URL/repos/$GITHUB_REPOSITORY"
mkdir -p ci-probe
command -v jq >/dev/null || sudo apt-get install -y --no-install-recommends jq
command -v unzip >/dev/null || sudo apt-get install -y --no-install-recommends unzip
{
  echo "================ РЕАЛЬНЫЙ ПРОГОН ci.yml НА MAIN ================"
  echo "sha:     $GITHUB_SHA"
  echo "ref:     $GITHUB_REF"
  echo "event:   $GITHUB_EVENT_NAME"
  echo "run:     $GITHUB_RUN_ID attempt $GITHUB_RUN_ATTEMPT"
  echo "run url: $GITHUB_SERVER_URL/$GITHUB_REPOSITORY/actions/runs/$GITHUB_RUN_ID"
  echo
  echo "---- итог job'ов (needs, виден и без API) ----"
  echo "skills: success"
  echo "rust:   success"
} > "$OUT" 2>&1

# --- job'ы и шаги этого прогона ---
curl -sS -H "Authorization: ***" -H "Accept: application/vnd.github+json" \
  "$API/actions/runs/$GITHUB_RUN_ID/jobs?per_page=100" -o jobs.json
echo "curl jobs exit=$?" >> "$OUT"
{
  echo
  echo "---- job'ы и шаги (Actions API, имя/статус/итог) ----"
  jq -r '.jobs[] | "[\(.name)] \(.status)/\(.conclusion) id=\(.id)", (.steps[]? | "    - \(.number). \(.name): \(.status)/\(.conclusion)")' jobs.json
} >> "$OUT" 2>&1

# --- логи обязательных job'ов: точные числа тестов и строка резолва пина ---
jq -r '.jobs[] | select((.name == "Validate skills") or (.name | startswith("Rust"))) | .id' jobs.json > jobids.txt
cat jobids.txt >> "$OUT"
while read -r jid; do
  [ -n "$jid" ] || continue
  curl -sSL -H "Authorization: ***" "$API/actions/jobs/$jid/logs" -o "log-$jid.zip"
  echo "curl log $jid exit=$?" >> "$OUT"
  rm -rf "log-$jid"
  unzip -o -q "log-$jid.zip" -d "log-$jid" 2>>"$OUT" && \
    cat "log-$jid"/* > "raw-$jid.log" 2>/dev/null && \
    sed -E 's/^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9:.]+Z //' "raw-$jid.log" \
      | sed -E 's/\x1b\[[0-9;]*m//g' > "clean-$jid.log"
done < jobids.txt

{
  echo
  echo "---- числа тестов ПО ШАГАМ (из групп логов; сравнить с 107/0/2 и 16/0) ----"
  awk '
    /^##\[group\]Run / { cur=$0; sub(/^##\[group\]Run /, "", cur) }
    /^test result:/   { p[cur]+=$4; f[cur]+=$6; i[cur]+=$8 }
    END { for (c in p) printf "%-72s passed=%d failed=%d ignored=%d\n", c, p[c], f[c], i[c] }
  ' clean-*.log 2>/dev/null | sort
  echo
  echo "---- пин toolchain в реальном прогоне ----"
  grep -hE "^(resolved toolchain|name:|active because:|release:|host:)" clean-*.log 2>/dev/null | head -12
  echo
  echo "---- признаки отказа в логах (пусто = нет) ----"
  grep -hE "^error|^error\[|^::error::|^panicked" clean-*.log 2>/dev/null | head -30
} >> "$OUT" 2>&1
echo "collect finished" >> "$OUT"
shell: /usr/bin/bash -e {0}
env:
  EVIDENCE_BRANCH: ci-probe-results
  OUT: ci-probe/main-run-report.txt
##[endgroup]
##[group]Run set -euxo pipefail
set -euxo pipefail
git config user.name "github-actions[bot]"
git config user.email "41898282+github-actions[bot]@users.noreply.github.com"
git checkout -B "$EVIDENCE_BRANCH"
cp "$OUT" ci-probe/ 2>/dev/null || true
cp clean-*.log raw-*.log jobs.json log-*.zip ci-probe/ 2>/dev/null || true
git add -A ci-probe
git commit -m "report: real ci.yml run on main ($GITHUB_SHA, run $GITHUB_RUN_ID)"
git push --force origin "HEAD:refs/heads/$EVIDENCE_BRANCH"
